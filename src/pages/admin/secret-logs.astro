---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import crypto from 'node:crypto';
import { db, SesionesLog, gte, desc } from 'astro:db';

// Misma verificación de seguridad HMAC
function verifySignedValue(signedValue: string, secret: string): string | null {
  const parts = signedValue.split('.');
  if (parts.length !== 2) return null;
  const [value, signature] = parts;
  const expectedSignature = crypto.createHmac('sha256', secret).update(value).digest('hex');

  if (
    signature.length === expectedSignature.length && 
    crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expectedSignature))
  ) {
    return value;
  }
  return null;
}

const sessionToken = Astro.cookies.get('admin_session')?.value;
const ADMIN_SECRET = import.meta.env.ADMIN_SECRET || process.env.ADMIN_SECRET;

const authData = (sessionToken && ADMIN_SECRET) 
  ? verifySignedValue(sessionToken, ADMIN_SECRET) 
  : null;

// Si alguien intenta entrar sin sesión válida, lo echa al login
if (!authData) {
  return Astro.redirect('/login');
}

// Obtener sesiones de los últimos 14 días
const haceDosSemanas = new Date();
haceDosSemanas.setDate(haceDosSemanas.getDate() - 14);

const registroSesiones = await db
  .select()
  .from(SesionesLog)
  .where(gte(SesionesLog.inicioSesion, haceDosSemanas))
  .orderBy(desc(SesionesLog.inicioSesion));

// Si finSesion es null (activa), calcula la duración hasta el momento actual (Date.now())
function calcularDuracion(inicio: Date, fin: Date | null): string {
  const fechaFin = fin ? new Date(fin) : new Date();
  const diffMs = Math.max(0, fechaFin.getTime() - new Date(inicio).getTime());
  const mins = Math.floor(diffMs / 60000);
  const horas = Math.floor(mins / 60);
  const minsRestantes = mins % 60;

  return horas > 0 ? `${horas}h ${minsRestantes}m` : `${minsRestantes} min`;
}
---

<Layout title="Auditoría Privada">
  <div style="max-width: 1000px; margin: 2rem auto; padding: 1rem; font-family: sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
      <h1> Registro de Accesos </h1>
      <a href="/admin/dashboard" style="color: #2563eb; text-decoration: none; font-weight: bold;">← Volver al Dashboard</a>
    </div>

    <table style="width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
      <thead>
        <tr style="background: #1e293b; color: white; text-align: left;">
          <th style="padding: 12px;">ID Sesión</th>
          <th style="padding: 12px;">UVUS</th>
          <th style="padding: 12px;">Inicio</th>
          <th style="padding: 12px;">Fin / Última Act.</th>
          <th style="padding: 12px;">Estado</th>
          <th style="padding: 12px;">Duración</th>
        </tr>
      </thead>
      <tbody>
        {registroSesiones.map((s) => (
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 12px;"><code>{s.sessionId}</code></td>
            <td style="padding: 12px;"><strong>{s.uvus}</strong></td>
            <td style="padding: 12px;">{new Date(s.inicioSesion).toLocaleString('es-ES')}</td>
            <td style="padding: 12px;">
              {s.finSesion 
                ? new Date(s.finSesion).toLocaleString('es-ES') 
                : `${new Date(s.ultimaActividad).toLocaleString('es-ES')} (En uso/Últ. recarga)`}
            </td>
            <td style="padding: 12px;">
              <span style={`padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; background: ${s.finSesion ? '#e2e8f0' : '#dcfce7'}; color: ${s.finSesion ? '#475569' : '#166534'};`}>
                {s.finSesion ? 'Cerrada' : 'Activa'}
              </span>
            </td>
            <td style="padding: 12px;">
              {s.finSesion ? (
                <code>{calcularDuracion(s.inicioSesion, s.finSesion)}</code>
              ) : (
                <code class="duracion-activa" data-inicio={new Date(s.inicioSesion).toISOString()}>
                  {calcularDuracion(s.inicioSesion, null)}
                </code>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>

<script>
  function refrescarDuracionesActivas() {
    const elementosActivos = document.querySelectorAll('.duracion-activa');

    elementosActivos.forEach((el) => {
      const inicioAttr = el.getAttribute('data-inicio');
      if (!inicioAttr) return;

      const inicioMs = new Date(inicioAttr).getTime();
      const diffMs = Math.max(0, Date.now() - inicioMs);
      const mins = Math.floor(diffMs / 60000);
      const horas = Math.floor(mins / 60);
      const minsRestantes = mins % 60;

      el.textContent = horas > 0 ? `${horas}h ${minsRestantes}m` : `${minsRestantes} min`;
    });
  }

  // Refrescar inmediatamente al cargar la página y luego cada 30 segundos
  refrescarDuracionesActivas();
  setInterval(refrescarDuracionesActivas, 30000);
</script>